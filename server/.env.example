PORT=4000
# Tuỳ chọn: AI xem tử vi và chat. API key miễn phí tạo ở aistudio.google.com → Get API key.
# Bỏ trống = tắt AI; lịch âm và hồ sơ vẫn chạy bình thường.
GEMINI_API_KEY=
# Tuỳ chọn: model Gemini, mặc định gemini-3.6-flash.
GEMINI_MODEL=
# Tuỳ chọn: model dự phòng khi model chính quá tải (503) hoặc hết lượt (429), mặc định gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=
# Tuỳ chọn: mật khẩu chung để dùng AI (web hỏi một lần rồi nhớ trên máy). Bỏ trống = ai cũng dùng được.
APP_PASSWORD=
